<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <TextView
        android:id="@+id/display"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="end"
        android:padding="16dp"
        android:text="0"
        android:textColor="@color/text_white"
        android:textSize="60sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeMaxTextSize="60sp"
        app:layout_constraintBottom_toTopOf="@+id/fila1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/fila1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/fila2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn7" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="7" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn8" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="8" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn9" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="9" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDiv" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="/" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_operator"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/fila3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn4" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="4" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn5" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="5" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn6" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="6" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMul" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="*" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_operator"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/fila4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn1" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="1" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn2" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="2" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn3" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="3" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSub" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="-" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_operator"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/fila5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn0" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="0" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDot" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="." android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="⌫" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_operator"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAdd" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="1" android:text="+" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_operator"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton android:id="@+id/btnClear" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="2" android:text="C" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_number"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEquals" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="80dp" android:layout_margin="4dp" android:layout_weight="2" android:text="=" android:textSize="24sp" app:cornerRadius="16dp" app:backgroundTint="@color/button_operator"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
